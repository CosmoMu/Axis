# Canonical AXIS environment template. Copy to .env and never commit real values.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1543309921066684567
DISCORD_APPLICATION_ID=
DISCORD_OWNER_USER_ID=
APPLY_CHANGES=false
DRY_RUN=true
LOG_LEVEL=INFO
TIMEZONE=America/Toronto

DATABASE_URL=postgresql+asyncpg://axis:password@127.0.0.1/axis

ATTACHMENT_STORAGE_PATH=var/attachments
MAX_ATTACHMENT_BYTES=10485760

LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_ROUTING_CONFIG=config/model_routing.yaml
LLM_DEFAULT_MODEL=gpt-5.6-terra
LLM_SIGNAL_MODEL=gpt-5.6-terra
LLM_SIGNAL_REPAIR_MODEL=gpt-5.6-terra
LLM_ANALYSIS_MODEL=gpt-5.6-terra
LLM_ANALYSIS_REWRITE_MODEL=gpt-5.6-terra
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_PROMPT_PATH=config/llm_trade_prompt.txt
LLM_ANALYSIS_PROMPT_PATH=config/llm_analysis_prompt.txt

PUBLIC_OPERATOR_NAME=VALE
PUBLIC_IDENTITY_FORBIDDEN_TERMS=

FEATURE_ANALYSIS_ENABLED=false
FEATURE_SIGNAL_ENABLED=true
FEATURE_WEEKLY_RESULTS=true
FEATURE_DAILY_SUMMARY_ENABLED=true
FEATURE_SHORT_TERM_TRACKING_ENABLED=false
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
SHORT_TERM_TRACKING_CONFIG=config/short_term_tracking.yaml
GEX_EXPLORER_ENABLED=false
GEX_EXPLORER_MODE=TEST
GEX_EXPLORER_POLICY=config/gex_explorer.yaml
FEATURE_AXIS_STOCK_ANALYST_ENABLED=false
