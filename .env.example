STOCK_ANALYST_MODE=TEST
STOCK_ANALYST_POLICY=config/stock_analyst.yaml
STOCK_ANALYST_POLICY_VERSION=COSMOS_STOCK_ANALYST_V0_1
FEATURE_LAB_ENABLED=false
FEATURE_MODEL_AB_ENABLED=false
NEW_MEMBER_FREE_TRIAL_ENABLED=true
NEW_MEMBER_FREE_TRIAL_TRADING_DAYS=3
NEW_MEMBER_FREE_TRIAL_AUTO_OFFER=true
NEW_MEMBER_FREE_TRIAL_DM_ENABLED=false
FEATURE_MOOMOO_ENABLED=false
FEATURE_GUILD_BRANDING=false

# Owner-only Personal Moomoo Execution. Safe defaults perform no broker writes.
