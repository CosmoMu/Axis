# Discord Secret / IDs
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_OWNER_USER_ID=

# Runtime safety
APPLY_CHANGES=false
DRY_RUN=true
LOG_LEVEL=INFO
TIMEZONE=America/Toronto

# Database
DATABASE_URL=postgresql+asyncpg://axis_user:change_me@localhost:5432/axis_desk

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Membership
SUBSCRIPTION_URL=
MEMBERSHIP_EXPIRY_CHECK_MINUTES=5

# Feature flags
FEATURE_WEEKLY_RESULTS=true
FEATURE_LAB_ENABLED=false
FEATURE_MOOMOO_ENABLED=false
FEATURE_MODEL_AB_ENABLED=false
FEATURE_GUILD_BRANDING=false

# Generated, non-secret IDs can be written to this file after bootstrap
DISCORD_IDS_PATH=config/discord_ids.json
