# Discord Secret / IDs
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_OWNER_USER_ID=

# Runtime safety
APPLY_CHANGES=false
DRY_RUN=true
LOG_LEVEL=INFO
TIMEZONE=America/Toronto

# Database
DATABASE_URL=postgresql+asyncpg://axis_user:change_me@localhost:5432/axis

# Signal input attachments (PNG/JPEG/WEBP only)
ATTACHMENT_STORAGE_PATH=var/attachments
MAX_ATTACHMENT_BYTES=10485760

# OpenAI / workload-based LLM routing
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_ROUTING_CONFIG=config/model_routing.yaml
LLM_DEFAULT_MODEL=gpt-5.6-terra
LLM_SIGNAL_MODEL=gpt-5.6-terra
LLM_SIGNAL_REPAIR_MODEL=gpt-5.6-terra
LLM_ANALYSIS_MODEL=gpt-5.6-terra
LLM_ANALYSIS_REWRITE_MODEL=gpt-5.6-terra
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_PROMPT_PATH=config/llm_trade_prompt.txt
LLM_ANALYSIS_PROMPT_PATH=config/llm_analysis_prompt.txt

# Future Analysis-only override (no business-code change):
# LLM_ANALYSIS_MODEL=gpt-5.6-sol
# LLM_ANALYSIS_REWRITE_MODEL=gpt-5.6-sol

# Membership
SUBSCRIPTION_URL=
MEMBERSHIP_EXPIRY_CHECK_MINUTES=5

# Read-only Moomoo market data / post-close summaries
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
DAILY_SUMMARY_TIME_ET=16:15

# Feature flags
FEATURE_SIGNAL_ENABLED=true
FEATURE_ANALYSIS_ENABLED=false
FEATURE_WEEKLY_RESULTS=true
FEATURE_DAILY_SUMMARY_ENABLED=true
FEATURE_LAB_ENABLED=false
FEATURE_MOOMOO_ENABLED=false
FEATURE_MODEL_AB_ENABLED=false
FEATURE_GUILD_BRANDING=false

# Generated, non-secret IDs can be written to this file after bootstrap
DISCORD_IDS_PATH=config/discord_ids.json
