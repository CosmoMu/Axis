{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AxisTradeParse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "action",
    "target_public_trade_id",
    "add_stage",
    "ticker",
    "expiry_input",
    "expiry_precision",
    "resolved_expiry",
    "expiry_resolution_status",
    "strike",
    "option_side",
    "entry_low",
    "entry_high",
    "action_price",
    "avg_cost",
    "sl",
    "tp1",
    "tp2",
    "plan_current_stock",
    "plan_starter",
    "plan_add_zone_low",
    "plan_add_zone_high",
    "plan_stock_sl",
    "plan_stock_pt1",
    "plan_stock_pt2",
    "plan_stock_pt3",
    "plan_fib_0618",
    "public_thesis",
    "position_delta_eighths",
    "position_after_eighths",
    "current_pnl_pct",
    "category_suggestion",
    "mentor_hint",
    "confidence",
    "price_parse_confidence",
    "missing_fields",
    "warnings",
    "summary"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["NEW_TRADE", "UPDATE_TRADE", "UNKNOWN"]
    },
    "action": {
      "type": "string",
      "enum": [
        "ENTRY",
        "ADD",
        "UPDATE",
        "TP1",
        "TP2",
        "RUNNER",
        "PARTIAL_SL",
        "SL",
        "CLOSE",
        "CANCEL",
        "ROLL",
        "UNKNOWN"
      ]
    },
    "target_public_trade_id": {
      "type": ["string", "null"],
      "pattern": "^(ST|SW|LP)-[0-9]{4,}$"
    },
    "add_stage": {
      "type": "string",
      "enum": ["NONE", "FIRST", "SECOND", "THIRD", "FOURTH", "UNKNOWN"]
    },
    "ticker": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9.\\-]{1,12}$"
    },
    "expiry_input": {
      "type": ["string", "null"],
      "maxLength": 32
    },
    "expiry_precision": {
      "type": ["string", "null"],
      "enum": ["EXACT_DATE", "MONTH_DAY", "MONTH_YEAR", "ZERO_DTE", "AUTO_NEAREST", null]
    },
    "resolved_expiry": {
      "type": ["string", "null"],
      "format": "date"
    },
    "expiry_resolution_status": {
      "type": "string",
      "enum": ["UNRESOLVED", "AUTO_RESOLVED", "MANAGER_CONFIRMED", "EXPLICIT"]
    },
    "strike": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "option_side": {
      "type": "string",
      "enum": ["CALL", "PUT", "UNKNOWN"]
    },
    "entry_low": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "entry_high": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "action_price": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "avg_cost": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "sl": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "tp1": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "tp2": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "plan_current_stock": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "plan_starter": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "plan_add_zone_low": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "plan_add_zone_high": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "plan_stock_sl": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "plan_stock_pt1": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "plan_stock_pt2": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "plan_stock_pt3": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "plan_fib_0618": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "public_thesis": {
      "type": ["string", "null"],
      "maxLength": 300
    },
    "position_delta_eighths": {
      "type": ["integer", "null"],
      "minimum": -8,
      "maximum": 8
    },
    "position_after_eighths": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 8
    },
    "current_pnl_pct": {
      "type": ["number", "null"]
    },
    "category_suggestion": {
      "type": "string",
      "enum": ["SHORT_TERM", "SWING", "LEAPS", "UNKNOWN"]
    },
    "mentor_hint": {
      "type": ["string", "null"],
      "maxLength": 100
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "price_parse_confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "missing_fields": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
